  "pinData": {
    "Information Extractor": [
      {
        "json": {
          "output": {
            "preferred_channel": "text",
            "script": "Hello! We're excited to share our new marketing campaign with you: HHN Early Access. Kick off Halloween Horror Nights with 20% off select Thursday tickets! This is a great opportunity to enjoy the event with a nice discount. If you have any questions about ticket options, Express Pass benefits, or ride details during your visit, feel free to ask. We're here to help make your experience smooth and memorable!"
          }
        }
      },
      {
        "json": {
          "output": {
            "preferred_channel": "email",
            "script": "Subject: Get Early Access to Halloween Horror Nights with 20% Off!\n\nDear [Customer Name],\n\nWe’re excited to offer you an exclusive early access deal to kick off Halloween Horror Nights! Enjoy 20% off select Thursday tickets and get ready for a spook-tacular time.\n\nAs you may know from your interest in early park admission and maximizing your visit, this offer is a great way to enhance your experience. Remember, staying at Cabana Bay or other Universal Hotels can include benefits like early park admission, so be sure to check your package details.\n\nIf you have any questions about shuttle times, ticket bundles, or hotel packages, feel free to reach out. We’re happy to help you make the most of your visit!\n\nDon’t miss out – secure your tickets today and start planning your unforgettable Halloween Horror Nights experience.\n\nBest regards,\nUniversal Orlando Resort Team"
          }
        }
      },
      {
        "json": {
          "output": {
            "preferred_channel": "voice",
            "script": "Hello! We’re excited to let you know about our new HHN Early Access marketing campaign. You can kick off Halloween Horror Nights with 20% off select Thursday tickets. Since you've previously asked about rides for children under 8, stroller rentals, and family-friendly options, this early access offer is a great opportunity to plan a fun and comfortable visit for your whole family. If you have any questions about the best attractions for kids or need help reserving tickets, feel free to ask. We’re here to make your visit enjoyable and hassle-free!"
          }
        }
      },
      {
        "json": {
          "output": {
            "preferred_channel": "text",
            "script": "Hello! We’re excited to announce our new Halloween Horror Nights Early Access campaign. You can kick off the spooky season with 20% off select Thursday tickets. If you have any questions about ticket availability, event details, or would like recommendations for less crowded houses, feel free to ask. We’re also happy to update you on merchandise restocks and any AP discounts that may apply. Don’t forget to check the app for showtimes and scare zones to make the most of your visit. Let us know how we can assist you with your HHN experience!"
          }
        }
      },
      {
        "json": {
          "output": {
            "preferred_channel": "email",
            "script": "Subject: Early Access to Halloween Horror Nights – Save 20% on Select Thursdays!\n\nHi [Customer Name],\n\nWe’re excited to offer you early access to our Halloween Horror Nights event! Kick off the spooky season with 20% off select Thursday tickets. It’s the perfect chance to enjoy all the thrills and chills with a great discount.\n\nSince you’ve shown interest in annual pass details, blackout dates, and special promotions, we wanted to make sure you didn’t miss this exclusive offer. If you have any questions about your pass perks, blackout dates, or other upcoming promotions, feel free to reach out!\n\nReady to secure your spot? Click here to grab your discounted tickets today.\n\nStay spooky,\n[Company/Team Name]"
          }
        }
      }
    ]
